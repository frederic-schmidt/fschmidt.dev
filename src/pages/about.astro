---
/**
 * About page
 * URL: /about
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import siteConfig from '@/config/site.config';
---
<PageLayout
  title={`About — ${siteConfig.name}`}
  description="Software architect based in Alsace, France, with over 30 years of experience in software engineering and architecture."
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="user" size="sm" />
      About me
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Frédéric Schmidt —</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">Software Architect</span>
    </h1>
    <p slot="description">
      30 years of experience building software, leading technical decisions, and designing platforms that last.
    </p>
  </Hero>

  <!-- Bio -->
  <section class="py-[var(--space-section-md)] bg-brand-500/8 dark:bg-background-secondary">
    <div class="mx-auto max-w-3xl px-6">
      <div class="flex flex-col gap-6" data-reveal>
        <p class="text-lg text-foreground-muted leading-relaxed">
          I'm a software architect based in Alsace, France, with over 30 years of experience in software engineering and architecture.
        </p>
        <p class="text-lg text-foreground-muted leading-relaxed">
          My work today focuses on platform engineering — building internal developer platforms, authentication infrastructure, and the tools that help teams ship better software. I work across AWS, Azure, and on-premise environments, with technologies like Backstage, .NET, Keycloak, and Kubernetes in production.
        </p>
        <p class="text-lg text-foreground-muted leading-relaxed">
          Beyond the platform itself, I ensure architectural consistency across teams and support projects outside the platform — from greenfield services to product migrations.
        </p>
        <p class="text-lg text-foreground-muted leading-relaxed">
          This site is my architect's notebook. I write about real decisions, real tradeoffs, and real experiences — not tutorials. If you've landed here, you probably care about the same things I do.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-[var(--space-section-md)] bg-background">
    <div class="mx-auto max-w-2xl px-6 text-center" data-reveal>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Want to get in touch?
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        I'm always open to a good conversation about architecture, platform engineering, or technical decisions.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="/contact">
          Contact me
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/blog">
          Read the Articles
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

